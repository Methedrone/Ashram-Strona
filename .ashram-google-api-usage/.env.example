# Dodaj do root .env (nie do tego folderu — dla spójności)

# ─── PageSpeed Insights (jedyny działający z samym API key) ───
ASHRAM_GOOGLE_API_KEY=AIzaSy...  # już masz w .env
# Dla większego bezpieczeństwa w Google Cloud Console: API restrictions = PageSpeed Insights API only

# ─── IndexNow (Bing + Yandex + inne) ───
# Wygeneruj: openssl rand -hex 16
# Hostuj public/{INDEXNOW_KEY}.txt z zawartością klucza
INDEXNOW_KEY=

# ─── Service account (wspólny dla GA4, GSC, Indexing API) ───
# 1. Google Cloud Console → IAM & Admin → Service Accounts → Create
# 2. Grant access: Analytics Viewer + Webmaster (do GSC dodaj ręcznie)
# 3. Create key (JSON) → zapisz w credentials/ashram-bot.json
# 4. chmod 600 credentials/ashram-bot.json
GOOGLE_APPLICATION_CREDENTIALS=/home/m/Work/Ashram-Strona/.ashram-google-api-usage/credentials/ashram-bot.json

# ─── GA4 (Google Analytics 4) ───
# Measurement ID → wklej do <head> strony (gtag.js)
# Property ID (numeric) → w Admin GA4 → Property settings → "Property ID"
GA4_MEASUREMENT_ID=G-XXXXXXXX
GA4_PROPERTY_ID=123456789

# ─── Google Search Console ───
# Identyczne jak URL dodany w GSC
GSC_SITE_URL=https://babaji.org.pl/

# ─── Web Search Indexing API ───
# Domyślnie: 200 publish/dzień. Po akceptacji wniosku: więcej.
# ⚠ Strona musi mieć schema.org/JobPosting lub BroadcastEvent
INDEXING_DAILY_QUOTA=200

# ─── Cloudflare Pages deploy hook (opcjonalne) ───
# CF Pages → Settings → Builds → Deploy hooks → Create
CF_DEPLOY_HOOK_URL=
