{
  "name": "@babaji/ashram-google-api-usage",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Google API integration for babaji.org.pl — PSI, GA4, GSC, Indexing, IndexNow",
  "scripts": {
    "psi": "node scripts/psi-snapshot.mjs",
    "psi:desktop": "node scripts/psi-snapshot.mjs --strategy desktop",
    "gsc:queries": "node scripts/gsc-searchanalytics.mjs --dimension query --row-limit 50",
    "gsc:pages": "node scripts/gsc-searchanalytics.mjs --dimension page --row-limit 50",
    "gsc:inspect": "node scripts/gsc-url-inspection.mjs --url https://babaji.org.pl/",
    "ga4:report": "node scripts/ga4-run-report.mjs",
    "ga4:admin": "node scripts/ga4-admin.mjs",
    "indexnow": "node scripts/indexnow-batch.mjs",
    "indexing": "node scripts/indexing-batch.mjs",
    "auth:diag": "node scripts/lib/google-auth.mjs --diag"
  },
  "dependencies": {
    "@google-analytics/data": "^4.x",
    "dotenv": "^17.3.1",
    "google-auth-library": "^9.x"
  },
  "engines": {
    "node": ">=18"
  }
}
