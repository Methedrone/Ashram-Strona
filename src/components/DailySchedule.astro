---
import { getLangFromUrl, useTranslations } from '../i18n/utils';
import { ui, defaultLang } from '../i18n/ui';
import SectionHeading from './SectionHeading.astro';

interface ScheduleItem {
  time: string;
  activity: string;
  period: 'morning' | 'afternoon' | 'evening';
}

interface Props {
  items?: ScheduleItem[];
}

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const defaultItems: ScheduleItem[] = [
  { time: '08:00', activity: 'Aarti', period: 'morning' },
  { time: '08:30', activity: 'Medytacja', period: 'morning' },
  { time: '09:00', activity: 'Śniadanie', period: 'morning' },
  { time: '10:00', activity: 'Karma Yoga', period: 'morning' },
  { time: '13:00', activity: 'Obiad', period: 'afternoon' },
  { time: '15:00', activity: 'Herbata', period: 'afternoon' },
  { time: '15:30', activity: 'Karma Yoga', period: 'afternoon' },
  { time: '18:00', activity: 'Aarti', period: 'evening' },
  { time: '19:00', activity: 'Kolacja', period: 'evening' },
  { time: '20:00', activity: 'Satsang', period: 'evening' },
];

const { items = defaultItems } = Astro.props;

const groupedItems = items.reduce((acc, item) => {
  if (!acc[item.period]) {
    acc[item.period] = [];
  }
  acc[item.period].push(item);
  return acc;
}, {} as Record<string, ScheduleItem[]>);

const periods = ['morning', 'afternoon', 'evening'] as const;
type UiKey = keyof typeof ui[typeof defaultLang];
---

<section class="daily-schedule">
  <div class="animate-in">
    <SectionHeading title={t('schedule.title')} />
  </div>
  
  <div class="schedule-container">
    {periods.map((period, index) => (
      groupedItems[period] && (
        <div class:list={['period-column', 'animate-in']} style={`animation-delay: ${0.15 + index * 0.1}s`}>
          <h3>{t(`schedule.${period}` as UiKey)}</h3>
          <ul class="schedule-list">
            {groupedItems[period].map((item) => (
              <li>
                <span class="time">{item.time}</span>
                <span class="activity">{item.activity}</span>
              </li>
            ))}
          </ul>
        </div>
      )
    ))}
  </div>
</section>

<style>
  .daily-schedule {
    padding: 4rem 2rem;
    background-color: var(--color-bg);
  }

  .schedule-container {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 2rem;
    max-width: 1200px;
    margin: 0 auto;
  }

  .period-column {
    /* Glassmorphism background */
    background: linear-gradient(
      135deg,
      rgba(255, 252, 247, 0.85) 0%,
      rgba(250, 248, 245, 0.65) 50%,
      rgba(255, 252, 247, 0.85) 100%
    );
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    
    border-radius: var(--radius-l);
    padding: 2rem;
    
    /* True glassmorphism depth */
    box-shadow: 
      0 12px 32px -8px var(--color-amber-glow),
      inset 0 1px 1px rgba(255, 255, 255, 0.9),
      inset 0 -1px 1px rgba(212, 175, 119, 0.1);
    
    /* No border, rely on inner shadow */
    border: none;
    border-top: 3px solid var(--color-gold);
    
    transition: all 0.5s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    position: relative;
  }

  .period-column:hover {
    transform: translateY(-8px) scale(1.01);
    box-shadow: 
      0 20px 40px -10px rgba(230, 168, 104, 0.4),
      0 8px 24px -6px rgba(155, 85, 57, 0.2),
      inset 0 1px 1px rgba(255, 255, 255, 1),
      inset 0 -1px 1px rgba(212, 175, 119, 0.1);
  }

  /* Ornament */
  .period-column::before {
    content: '✦';
    position: absolute;
    top: 1rem;
    right: 1rem;
    color: var(--color-gold);
    opacity: 0.2;
    font-size: 1.5rem;
    pointer-events: none;
    z-index: 0;
    transition: opacity 0.4s ease;
  }

  .period-column:hover::before {
    opacity: 0.4;
    text-shadow: 0 0 10px var(--color-gold);
  }

  /* Add paper texture */
  .period-column::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: var(--radius-l);
    background-image: 
      repeating-linear-gradient(
        0deg,
        transparent,
        transparent 2px,
        rgba(212, 175, 119, 0.02) 2px,
        rgba(212, 175, 119, 0.02) 4px
      );
    pointer-events: none;
    opacity: 0.6;
    z-index: 0;
  }
  
  /* Ensure content stays above textured background */
  .period-column > * {
    position: relative;
    z-index: 1;
  }

  h3 {
    color: var(--color-orange);
    font-family: var(--font-family-serif);
    font-size: 1.5rem;
    margin-bottom: 1.5rem;
    text-align: center;
    border-bottom: 1px solid var(--color-border);
    padding-bottom: 1rem;
  }

  .schedule-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .schedule-list li {
    display: flex;
    justify-content: space-between;
    padding: 0.75rem 0;
    border-bottom: 1px dashed var(--color-border);
  }

  .schedule-list li:last-child {
    border-bottom: none;
  }

  .time {
    font-weight: bold;
    color: var(--color-text);
    font-family: monospace;
    font-size: 1.1rem;
  }

  .activity {
    color: var(--color-text-light);
  }
</style>
