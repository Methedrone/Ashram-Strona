---
interface Props {
  class?: string;
  [key: string]: any;
}

const { class: className, ...rest } = Astro.props;
---

<article class:list={["card-base", className]} {...rest}>
  <slot />
</article>

<style>
  .card-base {
    /* Glassmorphism background */
    background: linear-gradient(
      135deg,
      rgba(255, 252, 247, 0.85) 0%,
      rgba(250, 248, 245, 0.65) 50%,
      rgba(255, 252, 247, 0.85) 100%
    );
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
     
    /* Softer organic corners */
    border-radius: var(--radius-l);
    
    /* Multi-layer depth: colored shadow + edge refraction */
    box-shadow: 
      0 12px 32px -8px var(--color-amber-glow),
      inset 0 1px 1px rgba(255, 255, 255, 0.9),
      inset 0 -1px 1px rgba(212, 175, 119, 0.1),
      inset 1px 0 1px rgba(255, 255, 255, 0.5),
      inset -1px 0 1px rgba(212, 175, 119, 0.05);
     
    /* No generic border, relying on inner shadow for edge definition */
    border: none;
    
    /* Allow overflow for ornaments */
    overflow: visible;
    position: relative;
    
    /* Spring physics transition */
    transition: all 0.5s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    height: 100%;
    display: flex;
  }

  .card-base:hover {
    transform: translateY(-8px) scale(1.01);
    box-shadow: 
      0 20px 40px -10px rgba(230, 168, 104, 0.4),
      0 8px 24px -6px rgba(155, 85, 57, 0.2),
      inset 0 1px 1px rgba(255, 255, 255, 1),
      inset 0 -1px 1px rgba(212, 175, 119, 0.1),
      /* Golden aura on hover using shadow instead of border */
      0 0 0 1px rgba(212, 175, 119, 0.3);
  }

  /* Paper texture overlay */
  .card-base::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: var(--radius-l);
    background-image: 
      repeating-linear-gradient(
        0deg,
        transparent,
        transparent 2px,
        rgba(212, 175, 119, 0.025) 2px,
        rgba(212, 175, 119, 0.025) 4px
      );
    pointer-events: none;
    opacity: 0.7;
    z-index: 0;
  }

  /* Lotus petal ornament */
  .card-base::before {
    content: '❀';
    position: absolute;
    top: 16px;
    right: 16px;
    color: var(--color-gold);
    opacity: 0.15;
    font-size: 1.4rem;
    transition: opacity 0.4s;
    pointer-events: none;
    z-index: 1;
  }
  
  .card-base:hover::before {
    opacity: 0.3;
  }

  /* Ensure content stays above texture */
  /* Using :global because the children are slotted */
  .card-base > :global(*) {
    position: relative;
    z-index: 1;
  }
</style>
