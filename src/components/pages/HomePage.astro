---
import { getCollection } from 'astro:content';
import DailySchedule from '../DailySchedule.astro';
import EventCard from '../EventCard.astro';
import Hero from '../Hero.astro';
import LocationMap from '../LocationMap.astro';
import LotusDivider from '../LotusDivider.astro';
import SectionHeading from '../SectionHeading.astro';
import TeachingCard from '../TeachingCard.astro';
import Layout from '../../layouts/Layout.astro';
import { useTranslations } from '../../i18n/utils';

interface Props {
  lang: 'pl' | 'en';
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const allEvents = await getCollection('events', ({ data }) => {
  return data.lang === lang && data.date >= new Date();
});
const latestEvents = allEvents
  .sort((a, b) => a.data.date.valueOf() - b.data.date.valueOf())
  .slice(0, 3);

const allTeachings = await getCollection('teachings', ({ data }) => {
  return data.lang === lang;
});
const latestTeachings = allTeachings
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

const path = (page: string) => (lang === 'pl' ? `/${page}` : `/en/${page}`);
---

<Layout title={t('nav.home')} description={t('meta.home.description')}>
  <Hero 
    title={t('hero.title')} 
    subtitle={t('hero.subtitle')}
    image="/images/havan-ceremony-group-fire-offerings.webp"
    ctaText={t('hero.cta')}
    ctaLink={path('contact')}
    size="large"
  />

  <DailySchedule />

  <LotusDivider />

  {latestEvents.length > 0 && (
    <section class="section-container">
      <SectionHeading title={t('nav.events')} />
      <div class="grid-container">
        {latestEvents.map(post => (
          <EventCard post={post} />
        ))}
      </div>
      <div class="center-btn">
        <a href={path('events')} class="btn-secondary">{t('events.viewAll')}</a>
      </div>
      <LotusDivider />
    </section>
  )}

  {latestTeachings.length > 0 && (
    <section class="section-container bg-alt">
      <SectionHeading title={t('nav.teachings')} />
      <div class="grid-container">
        {latestTeachings.map(post => (
          <TeachingCard post={post} />
        ))}
      </div>
      <div class="center-btn">
        <a href={path('teachings')} class="btn-secondary">{t('teachings.viewAll')}</a>
      </div>
      <LotusDivider />
    </section>
  )}

  <LocationMap />

  <section class="donation-cta">
    <div class="cta-content">
      <h2>{t('donations.title')}</h2>
      <p>{t('donations.description')}</p>
      <a
        href={path('donations')}
        class="btn-white"
        {...(lang === 'pl' ? { 'data-event': 'click_donate', 'data-event-label': 'Donate CTA (home)' } : {})}
      >{t('nav.donations')}</a>
    </div>
  </section>
</Layout>

<style>
  .section-container {
    padding: 4rem 2rem;
    max-width: 1200px;
    margin: 0 auto;
  }

  .bg-alt {
    background-color: var(--color-bg-alt);
    width: 100%;
    max-width: 100%;
    box-sizing: border-box;
  }
  
  /* Fix for full width background */
  section.bg-alt {
    padding: 4rem 2rem;
    margin: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  
  section.bg-alt > * {
    max-width: 1200px;
    width: 100%;
  }

  .grid-container {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 2rem;
    margin-bottom: 2rem;
  }

  .center-btn {
    text-align: center;
    margin-top: 2rem;
  }

  .donation-cta {
    background-color: var(--color-orange);
    color: white;
    padding: 4rem 2rem;
    text-align: center;
  }

  .cta-content {
    max-width: 800px;
    margin: 0 auto;
  }

  .donation-cta h2 {
    font-family: var(--font-family-serif);
    font-size: 2.5rem;
    margin-bottom: 1rem;
    color: #ffffff;
  }

  .donation-cta p {
    font-size: 1.2rem;
    margin-bottom: 2rem;
    color: #ffffff;
  }
</style>
