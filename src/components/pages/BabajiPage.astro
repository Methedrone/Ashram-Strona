---
import Breadcrumb from '../Breadcrumb.astro';
import LotusDivider from '../LotusDivider.astro';
import SectionHeading from '../SectionHeading.astro';
import { useTranslations } from '../../i18n/utils';
import Layout from '../../layouts/Layout.astro';

interface Props {
  lang: 'pl' | 'en';
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const siteUrl = import.meta.env.SITE;
const slugPath = (page: string) => (lang === 'pl' ? `/${page}` : `/en/${page}`);

const description = t('babaji.description');

const babajiSchema = {
  "@type": "Person",
  "name": t('babaji.schema.name'),
  "alternateName": [
    "Babaji",
    "Haidakhan Baba",
    "Shri Babaji",
    t('babaji.schema.alternateName')
  ],
  "description": t('babaji.schema.description'),
  "url": `${siteUrl}${slugPath('babaji')}`,
  "image": `${siteUrl}/images/gallery/babaji-with-devotees-vintage.webp`,
  "birthPlace": {
    "@type": "Place",
    "name": t('babaji.schema.birthPlace')
  },
  "deathDate": "1984-02-14",
  "deathPlace": {
    "@type": "Place",
    "name": t('babaji.schema.deathPlace')
  },
  "knowsAbout": [
    "Karma Yoga",
    "Mantra Yoga",
    "Havan",
    "Aarti",
    t('babaji.schema.meditation')
  ],
  "affiliation": {
    "@type": "ReligiousOrganization",
    "name": "Ashram Babaji",
    "url": siteUrl
  },
  "sameAs": [
    "https://en.wikipedia.org/wiki/Haidakhan_Babaji",
    "https://www.wikidata.org/wiki/Q5640371"
  ]
};
---

<Layout title={t('babaji.title')} description={description} ogImage="/images/havan-ceremony-group-fire-offerings.webp" schema={babajiSchema}>
  <div class="babaji-page">
    <section class="intro">
      <div class="container">
        <Breadcrumb items={[
          { label: t('nav.home'), href: lang === 'pl' ? '/' : '/en' },
          { label: 'Babaji' }
        ]} />
        <SectionHeading title={t('babaji.title')} subtitle={t('babaji.hero.subtitle')} level={1} />

        <div class="content-grid">
          <div class="text-content">
            <p>
              {t('babaji.intro.p1')}
            </p>
            <p>
              {t('babaji.intro.p2.before')} <strong>{t('babaji.intro.p2.truth')}</strong>, <strong>{t('babaji.intro.p2.simplicity')}</strong> {t('babaji.intro.p2.mid')} <strong>{t('babaji.intro.p2.love')}</strong>{t('babaji.intro.p2.after')}
            </p>
          </div>
          <div class="image-content">
            <img src="/images/gallery/babaji-with-devotees-vintage.webp" alt={t('babaji.image.alt')} />
          </div>
        </div>
      </div>
    </section>

    <LotusDivider />

    <section class="teachings bg-alt">
      <div class="container">
        <SectionHeading title={t('babaji.teachings.title')} />
        <div class="pillar-grid">
          <div class="pillar-card">
            <h3>{t('babaji.teachings.pillar1.title')}</h3>
            <p>{t('babaji.teachings.pillar1.text')}</p>
          </div>
          <div class="pillar-card">
            <h3>{t('babaji.teachings.pillar2.title')}</h3>
            <p>{t('babaji.teachings.pillar2.text')}</p>
          </div>
          <div class="pillar-card">
            <h3>{t('babaji.teachings.pillar3.title')}</h3>
            <p>{t('babaji.teachings.pillar3.text')}</p>
          </div>
        </div>
      </div>
    </section>

    <LotusDivider />

    <section class="practices">
      <div class="container">
        <SectionHeading title={t('babaji.practices.title')} subtitle={t('babaji.practices.subtitle')} />
        <div class="practice-list">
          <div class="practice-item">
            <h3>Karma Yoga</h3>
            <p>{t('babaji.practices.item1.text')}</p>
          </div>
          <div class="practice-item">
            <h3>Japa — Om Namah Shivaya</h3>
            <p>{t('babaji.practices.item2.text')}</p>
          </div>
          <div class="practice-item">
            <h3>Havan</h3>
            <p>{t('babaji.practices.item3.text')}</p>
          </div>
          <div class="practice-item">
            <h3>Aarti</h3>
            <p>{t('babaji.practices.item4.text')}</p>
          </div>
        </div>
      </div>
    </section>

    <LotusDivider />

    <section class="timeline bg-alt">
      <div class="container">
        <SectionHeading title={t('babaji.timeline.title')} subtitle={t('babaji.timeline.subtitle')} />
        <div class="timeline-list">
          <div class="timeline-entry">
            <span class="year">1970</span>
            <div>
              <h4>{t('babaji.timeline.entry1.title')}</h4>
              <p>{t('babaji.timeline.entry1.text')}</p>
            </div>
          </div>
          <div class="timeline-entry">
            <span class="year">1970–83</span>
            <div>
              <h4>{t('babaji.timeline.entry2.title')}</h4>
              <p>{t('babaji.timeline.entry2.text')}</p>
            </div>
          </div>
          <div class="timeline-entry">
            <span class="year">1984</span>
            <div>
              <h4>Mahasamadhi</h4>
              <p>{t('babaji.timeline.entry3.text')}</p>
            </div>
          </div>
          <div class="timeline-entry">
            <span class="year">1990</span>
            <div>
              <h4>{t('babaji.timeline.entry4.title')}</h4>
              <p>{t('babaji.timeline.entry4.text')}</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <LotusDivider />

    <section class="legacy">
      <div class="cta-content">
        <h2>{t('babaji.legacy.title')}</h2>
        <p>
          {t('babaji.legacy.text')}
        </p>
        <div class="cta-links">
          <a href={slugPath('teachings')} class="btn-primary">{t('babaji.legacy.link1')}</a>
          <a href={slugPath('events')} class="btn-secondary">{t('babaji.legacy.link2')}</a>
          <a href={slugPath('contact')} class="btn-secondary">{t('babaji.legacy.link3')}</a>
        </div>
      </div>
    </section>
  </div>
</Layout>

<style>
  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 2rem;
  }

  section {
    padding: 4rem 0;
  }

  .bg-alt {
    background: var(--color-bg-alt);
  }

  .content-grid {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: 3rem;
    align-items: center;
  }

  .image-content img {
    width: 100%;
    border-radius: 16px;
    box-shadow: var(--shadow-soft);
  }

  .pillar-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 2rem;
  }

  .pillar-card {
    background: var(--color-bg-warm);
    border-radius: 16px;
    padding: 2rem;
    border: 1px solid var(--color-border);
  }

  .practice-list {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 2rem;
  }

  .practice-item {
    padding: 1.5rem;
    border-radius: 12px;
    border: 1px solid var(--color-border);
    background: var(--color-bg-warm);
  }

  .timeline-list {
    display: grid;
    gap: 1.5rem;
  }

  .timeline-entry {
    display: grid;
    grid-template-columns: 90px 1fr;
    gap: 1.5rem;
    align-items: start;
    padding: 1.5rem;
    border-radius: 12px;
    border: 1px solid var(--color-border);
    background: var(--color-bg-warm);
  }

  .year {
    font-weight: 600;
    color: var(--color-orange);
  }

  .legacy {
    background: var(--color-bg-warm);
  }

  .cta-content {
    max-width: 800px;
    margin: 0 auto;
    text-align: center;
  }

  .cta-links {
    display: flex;
    justify-content: center;
    gap: 1rem;
    flex-wrap: wrap;
    margin-top: 2rem;
  }

  @media (max-width: 768px) {
    .content-grid {
      grid-template-columns: 1fr;
    }

    .timeline-entry {
      grid-template-columns: 1fr;
    }
  }
</style>
