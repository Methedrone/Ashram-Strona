---
import Breadcrumb from '../Breadcrumb.astro';
import FAQSchema from '../FAQSchema.astro';
import SectionHeading from '../SectionHeading.astro';
import { useTranslations } from '../../i18n/utils';
import Layout from '../../layouts/Layout.astro';

interface Props {
  lang: 'pl' | 'en';
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const homeHref = lang === 'pl' ? '/' : '/en';

const faqs = [
  {
    question: t('faq.q0'),
    answer: t('faq.a0')
  },
  {
    question: t('faq.q1'),
    answer: t('faq.a1')
  },
  {
    question: t('faq.q2'),
    answer: t('faq.a2')
  },
  {
    question: t('faq.q3'),
    answer: t('faq.a3')
  },
  {
    question: t('faq.q4'),
    answer: t('faq.a4')
  },
  {
    question: t('faq.q5'),
    answer: t('faq.a5')
  },
  {
    question: t('faq.q6'),
    answer: t('faq.a6')
  },
  {
    question: t('faq.q7'),
    answer: t('faq.a7')
  },
  {
    question: t('faq.q8'),
    answer: t('faq.a8')
  },
  {
    question: t('faq.q9'),
    answer: t('faq.a9')
  },
  {
    question: t('faq.q10'),
    answer: t('faq.a10')
  },
  {
    question: t('faq.q11'),
    answer: t('faq.a11')
  }
];
---

<Layout title="FAQ" description={t('faq.meta.description')}>
  <section class="faq-page">
    <div class="container">
      <Breadcrumb items={[{ label: t('nav.home'), href: homeHref }, { label: 'FAQ' }]} />
      <SectionHeading title={t('faq.title')} subtitle={t('faq.subtitle')} level={1} />

      <div class="faq-list">
        {faqs.map((faq) => (
          <details>
            <summary>{faq.question}</summary>
            <p>{faq.answer}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <FAQSchema faqs={faqs} />
</Layout>

<style>
  .faq-page {
    padding: 4rem 0;
  }

  .container {
    max-width: 900px;
    margin: 0 auto;
    padding: 0 2rem;
  }

  .faq-list {
    margin-top: 2rem;
    display: grid;
    gap: 1rem;
  }

  .faq-list details {
    border: 1px solid var(--color-border);
    border-radius: 12px;
    padding: 1rem 1.25rem;
    background: var(--color-bg-warm);
  }

  .faq-list summary {
    cursor: pointer;
    font-weight: 600;
    color: var(--color-text);
  }

  .faq-list p {
    margin: 0.75rem 0 0;
    color: var(--color-text-light);
  }
</style>
