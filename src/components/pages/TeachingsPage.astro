---
import { getCollection } from 'astro:content';
import SectionHeading from '../SectionHeading.astro';
import TeachingCard from '../TeachingCard.astro';
import Layout from '../../layouts/Layout.astro';
import { useTranslations } from '../../i18n/utils';

interface Props {
  lang: 'pl' | 'en';
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const siteUrl = import.meta.env.SITE;
const slugPath = (page: string) => (lang === 'pl' ? `/${page}` : `/en/${page}`);
const practicesHref = lang === 'pl' ? '/praktyki' : '/en/practices';

const allTeachings = await getCollection('teachings', ({ data }) => {
  return data.lang === lang;
});

const sortedTeachings = allTeachings.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const itemList = sortedTeachings.map((teaching, index) => ({
  "@type": "ListItem",
  "position": index + 1,
  "name": teaching.data.title,
  "url": `${siteUrl}${slugPath('teachings')}/${teaching.id.split('/').slice(1).join('/')}`
}));
---

<Layout title={t('nav.teachings')} description={t('meta.teachings.description')} ogImage="/images/havan-ceremony-group-fire-offerings.webp" schema={{
  "@type": "CollectionPage",
  "name": t('nav.teachings'),
  "description": t('meta.teachings.description'),
  "url": `${siteUrl}${slugPath('teachings')}`,
  "inLanguage": lang,
  "numberOfItems": sortedTeachings.length,
  "mainEntity": {
    "@type": "ItemList",
    "itemListElement": itemList
  }
}}>
  <section class="teachings-page">
    <div class="container">
      <SectionHeading title={t('nav.teachings')} subtitle={t('teachings.subtitle')} level={1} />

      <p class="intro">
        {t('teachings.intro.before')} <a href={practicesHref}>{t('teachings.intro.practicesLink')}</a>
        {t('teachings.intro.mid')} <a href={slugPath('events')}>{t('teachings.intro.eventsLink')}</a>{t('teachings.intro.after')}
      </p>
      
      {sortedTeachings.length > 0 ? (
        <div class="teachings-grid">
          {sortedTeachings.map(post => (
            <TeachingCard post={post} />
          ))}
        </div>
      ) : (
        <p class="no-content">{t('teachings.empty')}</p>
      )}
    </div>
  </section>
</Layout>

<style>
  .teachings-page {
    padding: 4rem 0;
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 2rem;
  }

  .teachings-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 2rem;
  }

  .intro {
    font-size: 1.1rem;
    line-height: 1.7;
    color: var(--color-text-light);
    margin: 1.5rem 0 3rem;
  }

  .intro a {
    color: var(--color-orange);
    text-decoration: none;
  }

  .intro a:hover {
    text-decoration: underline;
  }

  .no-content {
    text-align: center;
    font-size: 1.2rem;
    color: var(--color-text-light);
    margin-top: 2rem;
  }
</style>
