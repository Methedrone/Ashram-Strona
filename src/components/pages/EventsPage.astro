---
import { getCollection } from 'astro:content';
import EventCard from '../EventCard.astro';
import SectionHeading from '../SectionHeading.astro';
import Layout from '../../layouts/Layout.astro';
import { useTranslations } from '../../i18n/utils';

interface Props {
  lang: 'pl' | 'en';
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const siteUrl = import.meta.env.SITE;
const slugPath = (page: string) => (lang === 'pl' ? `/${page}` : `/en/${page}`);
const practicesHref = lang === 'pl' ? '/praktyki' : '/en/practices';

const allEvents = await getCollection('events', ({ data }) => {
  return data.lang === lang;
});

const sortedEvents = allEvents.sort((a, b) => a.data.date.valueOf() - b.data.date.valueOf());

const upcomingEvents = sortedEvents.filter(event => event.data.date >= new Date());
const pastEvents = sortedEvents.filter(event => event.data.date < new Date()).reverse();
const itemList = sortedEvents.map((event, index) => ({
  "@type": "ListItem",
  "position": index + 1,
  "name": event.data.title,
  "url": `${siteUrl}${slugPath('events')}/${event.id.split('/').slice(1).join('/')}`
}));
---

<Layout title={t('nav.events')} description={t('meta.events.description')} ogImage="/images/havan-ceremony-group-fire-offerings.webp" schema={{
  "@type": "CollectionPage",
  "name": t('nav.events'),
  "description": t('meta.events.description'),
  "url": `${siteUrl}${slugPath('events')}`,
  "inLanguage": lang,
  "numberOfItems": upcomingEvents.length,
  "mainEntity": {
    "@type": "ItemList",
    "itemListElement": itemList
  }
}}>
  <section class="events-page">
    <div class="container">
      <SectionHeading title={t('nav.events')} subtitle={t('events.subtitle')} level={1} />

      <p class="intro">
        {t('events.intro.before')} <a href={practicesHref}>{t('events.intro.practicesLink')}</a>
        {t('events.intro.mid')} <a href={slugPath('teachings')}>{t('events.intro.teachingsLink')}</a>{t('events.intro.after')}
      </p>
      
      {upcomingEvents.length > 0 ? (
        <div class="events-grid">
          {upcomingEvents.map(post => (
            <EventCard post={post} />
          ))}
        </div>
      ) : (
        <p class="no-content">{t('events.empty')}</p>
      )}

      {pastEvents.length > 0 && (
        <div class="past-events">
          <SectionHeading title={t('events.pastTitle')} align="left" />
          <div class="events-grid">
            {pastEvents.map(post => (
              <EventCard post={post} />
            ))}
          </div>
        </div>
      )}
    </div>
  </section>
</Layout>

<style>
  .events-page {
    padding: 4rem 0;
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 2rem;
  }

  .events-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 2rem;
    margin-bottom: 4rem;
  }

  .intro {
    font-size: 1.1rem;
    line-height: 1.7;
    color: var(--color-text-light);
    margin: 1.5rem 0 3rem;
  }

  .intro a {
    color: var(--color-orange);
    text-decoration: none;
  }

  .intro a:hover {
    text-decoration: underline;
  }

  .past-events {
    margin-top: 4rem;
    padding-top: 2rem;
    border-top: 1px solid var(--color-border);
  }

  .no-content {
    text-align: center;
    font-size: 1.2rem;
    color: var(--color-text-light);
    margin-top: 2rem;
  }
</style>
