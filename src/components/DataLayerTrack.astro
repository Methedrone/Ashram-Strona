// SSR-renderowany komponent (zero client JS w bundlu)
// Zmienne inline przekazujemy bezpośrednio do skryptu
---

<script
  is:inline
>
  // Konfiguracja — łatwa do zmiany w jednym miejscu
  const TRACK_OUTBOUND = true;
  const TRACK_DOWNLOADS = true;
  const TRACK_SCROLL_DEPTH = true;
  const SCROLL_THRESHOLDS = [25, 50, 75, 100];
  const DOWNLOAD_EXTENSIONS = /\.(pdf|doc|docx|xls|xlsx|zip|rar|7z|tar|gz)$/i;

  // Inicjalizacja dataLayer
  window.dataLayer = window.dataLayer || [];

  // ─── 1. data-event="..." click handler ───────────────────────
  document.addEventListener('click', (e) => {
    const target = e.target instanceof Element ? e.target.closest('[data-event]') : null;
    if (!target) return;
    let data = {};
    try {
      data = target.dataset.eventData ? JSON.parse(target.dataset.eventData) : {};
    } catch (err) {
      console.warn('[gtm] Invalid data-event-data JSON', err);
    }
    window.dataLayer.push({
      event: target.dataset.event,
      event_label: target.dataset.eventLabel ?? (target.textContent?.trim().slice(0, 100) || ''),
      page_path: window.location.pathname,
      timestamp: new Date().toISOString(),
      ...data,
    });
  });

  // ─── 2. Outbound links ──────────────────────────────────────
  if (TRACK_OUTBOUND) {
    document.addEventListener('click', (e) => {
      const a = e.target instanceof Element ? e.target.closest('a[href]') : null;
      if (!a) return;
      const href = a.getAttribute('href');
      if (!href || href.startsWith('#') || href.startsWith('/') || href.startsWith('mailto:') || href.startsWith('tel:')) return;
      try {
        const url = new URL(href);
        if (url.hostname !== window.location.hostname) {
          window.dataLayer.push({
            event: 'outbound_link',
            outbound_url: href,
            outbound_host: url.hostname,
            page_path: window.location.pathname,
          });
        }
      } catch {}
    });
  }

  // ─── 3. File downloads ──────────────────────────────────────
  if (TRACK_DOWNLOADS) {
    document.addEventListener('click', (e) => {
      const a = e.target instanceof Element ? e.target.closest('a[href]') : null;
      if (!a) return;
      const href = a.getAttribute('href') ?? '';
      const match = href.match(DOWNLOAD_EXTENSIONS);
      if (match) {
        window.dataLayer.push({
          event: 'file_download',
          file_name: href.split('/').pop(),
          file_type: match[1].toLowerCase(),
          page_path: window.location.pathname,
        });
      }
    });
  }

  // ─── 4. Scroll depth ────────────────────────────────────────
  if (TRACK_SCROLL_DEPTH) {
    const fired = new Set();
    const checkScroll = () => {
      const h = document.documentElement;
      const b = document.body;
      const st = window.pageYOffset || h.scrollTop || b.scrollTop || 0;
      const sh = (h.scrollHeight || b.scrollHeight) - h.clientHeight;
      if (sh <= 0) return;
      const pct = Math.round((st / sh) * 100);
      for (const t of SCROLL_THRESHOLDS) {
        if (pct >= t && !fired.has(t)) {
          fired.add(t);
          window.dataLayer.push({
            event: 'scroll_depth',
            scroll_percent: t,
            page_path: window.location.pathname,
          });
        }
      }
    };
    let scrollTimer;
    window.addEventListener('scroll', () => {
      if (scrollTimer) return;
      scrollTimer = setTimeout(() => { scrollTimer = null; checkScroll(); }, 200);
    }, { passive: true });
  }

  // ─── 5. Language switch ─────────────────────────────────────
  document.addEventListener('click', (e) => {
    const a = e.target instanceof Element ? e.target.closest('[data-lang-switch]') : null;
    if (!a) return;
    const to = a.dataset.langSwitch;
    const from = document.documentElement.lang ?? 'pl';
    if (to && to !== from) {
      window.dataLayer.push({
        event: 'language_switch',
        from_lang: from,
        to_lang: to,
        page_path: window.location.pathname,
      });
    }
  });
</script>
