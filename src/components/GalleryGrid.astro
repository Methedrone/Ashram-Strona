---
import { getLangFromUrl, useTranslations } from '../i18n/utils';
import SectionHeading from './SectionHeading.astro';

import { LightGallery } from 'astro-lightgallery';

interface ImageItem {
  src: string;
  alt: string;
  subHtml?: string;
  srcThumb?: string;
  loading?: 'lazy' | 'eager';
}

interface Props {
  images?: ImageItem[];
  limit?: number;
  title?: string;
  hideTitle?: boolean;
  emptyStateText?: string;
}

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const defaultImages: ImageItem[] = [
  { src: '/images/gallery/ashram-courtyard-garden-archway.webp', srcThumb: '/images/optimized/gallery/ashram-courtyard-garden-archway-w480.webp', alt: 'Ashram courtyard with brick archway and garden', subHtml: 'Ashram courtyard and garden', loading: 'lazy' },
  { src: '/images/gallery/sacred-temple-room-candles-altar.webp', srcThumb: '/images/optimized/gallery/sacred-temple-room-candles-altar-w480.webp', alt: 'Sacred temple room with altar, candles and rugs', subHtml: 'Temple interior', loading: 'lazy' },
  { src: '/images/gallery/havan-procession-woman-offerings.webp', srcThumb: '/images/optimized/gallery/havan-procession-woman-offerings-w480.webp', alt: 'Woman in yellow sari carrying offerings during Aarti procession', subHtml: 'Aarti ceremony', loading: 'lazy' },
  { src: '/images/gallery/vegetable-garden-leeks-organic.webp', srcThumb: '/images/optimized/gallery/vegetable-garden-leeks-organic-w480.webp', alt: 'Row of leeks in ashram organic garden', subHtml: 'Ashram vegetable garden', loading: 'lazy' },
  { src: '/images/gallery/temple-room-babaji-portrait-altar.webp', srcThumb: '/images/optimized/gallery/temple-room-babaji-portrait-altar-w480.webp', alt: 'Meditation room with Babaji portrait on altar', subHtml: 'Altar with Babaji portrait', loading: 'lazy' },
  { src: '/images/gallery/autumn-meadow-mountains-golden-grass.webp', srcThumb: '/images/optimized/gallery/autumn-meadow-mountains-golden-grass-w480.webp', alt: 'Autumn meadow with view of Golden Mountains', subHtml: 'View of Golden Mountains', loading: 'lazy' },
];

const { images = defaultImages, limit, title, hideTitle = false, emptyStateText } = Astro.props;
const displayImages = limit ? images.slice(0, limit) : images;
---

<section class="gallery-grid">
  {!hideTitle && (
    <div class="gallery-grid__heading">
      <p class="gallery-grid__eyebrow">{lang === 'pl' ? 'obrazy i archiwum' : 'images and archive'}</p>
      <SectionHeading title={title || t('nav.gallery')} align="left" />
    </div>
  )}
  
  <div class="gallery-container">
    {displayImages.length > 0 ? (
      <LightGallery
        layout={{
          imgs: displayImages,
          classItem: 'gallery-item'
        }}
        options={{
          thumbnail: true,
          preload: 1,
          // @ts-ignore - requested by prompt but not in types
          lazyLoad: true
        }}
      />
    ) : (
      <div class="empty-state">
        <div class="empty-icon">❀</div>
        <h3>{emptyStateText || t('gallery.empty')}</h3>
        <p>{t('gallery.comingSoon')}</p>
      </div>
    )}
  </div>
  {limit && limit < images.length && (
    <div class="view-all">
      <a href={lang === 'pl' ? '/gallery' : '/en/gallery'} class="view-all-btn">
        <span>{t('gallery.viewAll')}</span>
        <span class="view-all-btn__icon" aria-hidden="true">↗</span>
      </a>
    </div>
  )}
</section>

<style>
  .gallery-grid {
    padding: 4.5rem 1.25rem;
    background-color: transparent;
  }

  .gallery-grid__heading {
    max-width: 1200px;
    margin: 0 auto 1.5rem;
  }

  .gallery-grid__heading :global(.section-heading) {
    margin-bottom: 0;
  }

  .gallery-grid__eyebrow {
    margin: 0 0 1rem;
    font-size: 0.72rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--color-text-light);
    font-weight: 600;
  }

  .gallery-container {
    max-width: 1200px;
    margin: 0 auto;
  }

  .gallery-item {
    position: relative;
    border-radius: 1.8rem;
    padding: 0.75rem;
    background: rgba(255, 252, 247, 0.82);
    box-shadow:
      0 22px 42px -28px rgba(58, 35, 20, 0.35),
      inset 0 1px 0 rgba(255, 255, 255, 0.92);
    cursor: pointer;
    transition: transform 320ms cubic-bezier(0.32, 0.72, 0, 1), box-shadow 320ms cubic-bezier(0.32, 0.72, 0, 1);
    overflow: hidden;
    display: block;
    text-decoration: none;
  }

  .gallery-item::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    padding: 1px;
    background: linear-gradient(135deg, rgba(212, 175, 119, 0.45), rgba(155, 85, 57, 0.16));
    -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
    -webkit-mask-composite: xor;
    mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
    mask-composite: exclude;
    pointer-events: none;
    opacity: 0.7;
  }

  .gallery-item::before {
    content: '❀';
    position: absolute;
    top: 0.9rem;
    right: 1rem;
    color: var(--color-gold, #D4AF77);
    opacity: 0.12;
    font-size: 1.2rem;
    pointer-events: none;
    z-index: 1;
    transition: opacity 0.4s;
  }
  
  .gallery-item:hover::before {
    opacity: 0.25;
  }

  .gallery-item:hover {
    transform: translateY(-6px) rotate(-0.3deg);
    box-shadow:
      0 30px 52px -26px rgba(58, 35, 20, 0.45),
      inset 0 1px 0 rgba(255, 255, 255, 1);
  }

  .gallery-item img {
    border-radius: 1.2rem;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: opacity 0.3s ease, transform 0.45s cubic-bezier(0.32, 0.72, 0, 1);
  }

  .gallery-item:hover img {
    opacity: 0.94;
    transform: scale(1.03);
  }

  /* Removed overlay since LightGallery handles captions in lightbox */

  .view-all {
    text-align: center;
    margin-top: 3rem;
  }

  .view-all-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.85rem;
    background: linear-gradient(135deg, var(--color-orange) 0%, var(--color-orange-hover) 100%);
    color: white;
    padding: 0.42rem 0.42rem 0.42rem 1.2rem;
    border-radius: 999px;
    text-decoration: none;
    font-weight: 600;
    transition: transform 300ms cubic-bezier(0.32, 0.72, 0, 1), box-shadow 300ms cubic-bezier(0.32, 0.72, 0, 1);
    box-shadow: 0 18px 34px -20px rgba(155, 85, 57, 0.6);
  }

  .view-all-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 24px 40px -22px rgba(155, 85, 57, 0.68);
  }

  .view-all-btn:active {
    transform: translateY(1px) scale(0.985);
  }

  .view-all-btn__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.2rem;
    height: 2.2rem;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.14);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.2);
    transition: transform 300ms cubic-bezier(0.32, 0.72, 0, 1);
  }

  .view-all-btn:hover .view-all-btn__icon {
    transform: translate3d(0.18rem, -0.08rem, 0);
  }

  .empty-state {
    grid-column: 1 / -1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 4rem 2rem;
    text-align: center;
    background: linear-gradient(135deg, rgba(255,252,247,0.84) 0%, rgba(250,248,245,0.78) 100%);
    border: 1px dashed rgba(212, 175, 119, 0.42);
    border-radius: 1.6rem;
    box-shadow: inset 0 0 20px rgba(230, 168, 104, 0.08);
  }

  .empty-icon {
    font-size: 3rem;
    color: var(--color-gold);
    opacity: 0.5;
    margin-bottom: 1rem;
    animation: pulse 4s infinite ease-in-out;
  }

  .empty-state h3 {
    font-family: var(--font-family-serif);
    font-size: 1.8rem;
    color: var(--color-text-warm);
    margin: 0 0 0.5rem 0;
  }

  .empty-state p {
    color: var(--color-text-light);
    font-size: 1.1rem;
    max-width: 400px;
    margin: 0;
  }

  @keyframes pulse {
    0%, 100% { opacity: 0.4; transform: scale(1); }
    50% { opacity: 0.7; transform: scale(1.1); }
  }
</style>
