---
import { getLangFromUrl, useTranslations } from '../i18n/utils';
import SectionHeading from './SectionHeading.astro';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const address = "Mąkolno 129, 57-250 Mąkolno, Poland";
const googleMapsLink = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(address)}`;
const googleEmbedUrl = `https://www.google.com/maps?q=${encodeURIComponent(address)}&output=embed`;
---

<section class="location-map">
  <div class="container reveal">
    <div class="location-map__intro">
      <p class="eyebrow">dojazd</p>
      <SectionHeading title={t('location.title')} align="left" />
    </div>
  </div>
  
  <div class="map-container reveal">
    <div class="map-shell">
      <div class="map-frame">
      <iframe 
        src={googleEmbedUrl}
        class="map-embed"
        allowfullscreen="" 
        loading="lazy" 
        referrerpolicy="no-referrer-when-downgrade"
        title="Ashram Location Map"
      ></iframe>
      </div>
    </div>
    
    <div class="location-info">
      <div class="address">
        <svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>
        <p>{address}</p>
      </div>
      
      <a href={googleMapsLink} target="_blank" rel="noopener noreferrer" class="directions-btn">
        <span>{t('location.directions')}</span>
        <span class="directions-btn__icon" aria-hidden="true">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><polygon points="3 11 22 2 13 21 11 13 3 11"></polygon></svg>
        </span>
      </a>
    </div>
  </div>
</section>

<style>
  .location-map {
    padding: 6rem 1.25rem;
    background: linear-gradient(180deg, rgba(245, 243, 239, 0.55), rgba(245, 243, 239, 0.95));
  }

  .container {
    width: min(100%, 1240px);
    margin: 0 auto;
  }

  .location-map__intro {
    margin-bottom: 2rem;
  }

  .eyebrow {
    margin: 0 0 1rem;
    font-size: 0.72rem;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--color-text-light);
    font-weight: 600;
  }

  .map-container {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(18rem, 0.75fr);
    gap: 1.5rem;
    max-width: 1240px;
    margin: 0 auto;
  }

  .map-shell {
    padding: 0.8rem;
    border-radius: 2rem;
    background: rgba(255, 252, 247, 0.52);
    box-shadow: 0 30px 70px -44px rgba(58, 35, 20, 0.45);
  }

  .map-frame {
    height: 400px;
    border-radius: 1.5rem;
    overflow: hidden;
    background: var(--color-border);
  }

  .map-embed {
    width: 100%;
    height: 100%;
    border: 0;
  }

  .location-info {
    padding: 2rem;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 1.75rem;
    border-radius: 2rem;
    background: rgba(255, 252, 247, 0.8);
    box-shadow: 0 24px 52px -40px rgba(58, 35, 20, 0.42), inset 0 1px 0 rgba(255, 255, 255, 0.85);
  }

  .address {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    color: var(--color-text);
  }

  .address p {
    margin: 0;
    max-width: none;
    font-size: 1.05rem;
    line-height: 1.7;
  }

  .icon {
    color: var(--color-orange);
    margin-top: 0.2rem;
    flex-shrink: 0;
  }

  .directions-btn {
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    width: fit-content;
    background: linear-gradient(135deg, var(--color-orange), var(--color-orange-hover));
    color: white;
    padding: 0.45rem 0.45rem 0.45rem 1.2rem;
    border-radius: 999px;
    text-decoration: none;
    font-weight: 600;
    transition: transform 300ms cubic-bezier(0.32, 0.72, 0, 1), box-shadow 300ms cubic-bezier(0.32, 0.72, 0, 1);
    box-shadow: 0 18px 34px -20px rgba(155, 85, 57, 0.7);
  }

  .directions-btn:hover {
    transform: translateY(-2px);
  }

  .directions-btn:active {
    transform: translateY(1px) scale(0.985);
  }

  .directions-btn__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.2rem;
    height: 2.2rem;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.14);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.22);
    transition: transform 300ms cubic-bezier(0.32, 0.72, 0, 1);
  }

  .directions-btn:hover .directions-btn__icon {
    transform: translate3d(0.16rem, -0.08rem, 0);
  }

  @media (max-width: 900px) {
    .map-container {
      grid-template-columns: 1fr;
    }

    .location-info {
      padding: 1.5rem;
    }
  }
</style>
