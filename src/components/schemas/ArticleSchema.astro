---
interface Props {
  data: {
    title: string;
    description: string;
    date: Date;
    author: string;
    lang: string;
    featuredImage?: string;
    tags?: string[];
    faqs?: { question: string; answer: string }[];
    updatedAt?: Date;
    slug?: string;
  };
  lang: 'pl' | 'en';
}

const { data, lang } = Astro.props;
const siteUrl = 'https://babaji.org.pl';

const ogImagePath = data.featuredImage || '/images/havan-ceremony-group-fire-offerings.webp';
const baseSlug = data.slug || '';
const articleUrl = `${siteUrl}/${lang === 'pl' ? '' : 'en/'}teachings/${baseSlug}`;
const articleImage = `${siteUrl}${ogImagePath}`;
const updatedAt = data.updatedAt ?? data.date;
const keywords = data.tags?.join(', ');

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  'headline': data.title,
  'description': data.description,
  'author': {
    '@type': 'Person',
    'name': data.author
  },
  'datePublished': data.date.toISOString(),
  'dateModified': updatedAt.toISOString(),
  'image': articleImage,
  'keywords': keywords,
  'mainEntityOfPage': {
    '@type': 'WebPage',
    '@id': articleUrl
  },
  'inLanguage': lang,
  'url': articleUrl,
  'publisher': {
    '@type': 'ReligiousOrganization',
    'name': 'Ashram Babaji',
    'url': 'https://babaji.org.pl'
  }
};
---

<script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />