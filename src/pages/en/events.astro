---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import EventCard from '../../components/EventCard.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import { useTranslations } from '../../i18n/utils';

const lang = 'en';
const t = useTranslations(lang);
const siteUrl = 'https://babaji.org.pl';

const allEvents = await getCollection('events', ({ data }) => data.lang === lang);
const sortedEvents = allEvents.sort((a, b) => a.data.date.valueOf() - b.data.date.valueOf());
const upcomingEvents = sortedEvents.filter((event) => event.data.date >= new Date());
const pastEvents = sortedEvents.filter((event) => event.data.date < new Date()).reverse();

const itemList = sortedEvents.map((event, index) => ({
  '@type': 'ListItem',
  position: index + 1,
  name: event.data.title,
  url: `${siteUrl}/en/events/${event.slug.split('/').slice(1).join('/')}`,
}));
---

<Layout title={t('nav.events')} description={t('meta.events.description')} ogImage="/og/events.jpg" schema={{
  '@type': 'CollectionPage',
  name: t('nav.events'),
  description: t('meta.events.description'),
  url: 'https://babaji.org.pl/en/events',
  inLanguage: 'en',
  numberOfItems: upcomingEvents.length,
  mainEntity: {
    '@type': 'ItemList',
    itemListElement: itemList,
  },
}}>
  <section class="listing-page">
    <div class="container">
      <div class="listing-hero reveal">
        <div>
          <p class="eyebrow">shared practice</p>
          <SectionHeading title={t('nav.events')} subtitle="Festivals, workshops, and gatherings shaped by the daily rhythm of the Ashram" level={1} align="left" />
        </div>
        <div class="listing-hero__aside">
          <p>
            Events at the Ashram are not separate from ordinary life here. They grow out of ritual,
            service, shared staying, and a slower pace of practice.
          </p>
          <div class="listing-stats">
            <article>
              <span>upcoming</span>
              <strong>{upcomingEvents.length}</strong>
            </article>
            <article>
              <span>archive</span>
              <strong>{pastEvents.length}</strong>
            </article>
          </div>
        </div>
      </div>

      {upcomingEvents.length > 0 ? (
        <>
          <div class="section-split reveal">
            <div>
              <p class="eyebrow">now</p>
              <SectionHeading title="Upcoming events" align="left" />
            </div>
            <p class="section-note">
              To go further, explore our <a href="/en/practices">spiritual practices</a> and <a href="/en/teachings">teachings</a> alongside the calendar.
            </p>
          </div>

          <div class="listing-grid reveal-children">
            {upcomingEvents.map((post, index) => (
              <div class:list={['listing-grid__item', `listing-grid__item--${index + 1}`]}>
                <EventCard post={post} />
              </div>
            ))}
          </div>
        </>
      ) : (
        <div class="empty-shell reveal">
          <span>✦</span>
          <h2>No upcoming events are scheduled at the moment.</h2>
          <p>The calendar is updated as plans settle. In the meantime, you can contact us about the current rhythm of Ashram life.</p>
        </div>
      )}

      {pastEvents.length > 0 && (
        <section class="archive-section reveal">
          <div class="section-split">
            <div>
              <p class="eyebrow">before</p>
              <SectionHeading title="Past events" align="left" />
            </div>
            <p class="section-note">The archive shows how festivals, workshops, and shared gatherings have unfolded over the years.</p>
          </div>

          <div class="listing-grid listing-grid--archive reveal-children">
            {pastEvents.map((post, index) => (
              <div class:list={['listing-grid__item', `listing-grid__item--${(index % 3) + 1}`]}>
                <EventCard post={post} />
              </div>
            ))}
          </div>
        </section>
      )}
    </div>
  </section>
</Layout>

<style>
  .listing-page {
    padding: 4rem 0 5rem;
  }

  .container {
    width: min(100% - 2.5rem, 1200px);
    margin: 0 auto;
  }

  .eyebrow {
    margin: 0 0 1rem;
    font-size: 0.72rem;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--color-text-light);
    font-weight: 600;
  }

  .listing-hero,
  .section-split {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(18rem, 25rem);
    gap: 2rem;
    align-items: end;
  }

  .listing-hero {
    margin-bottom: 3rem;
    padding: 2.25rem;
    border-radius: 2rem;
    background: rgba(255, 252, 247, 0.76);
    box-shadow: 0 28px 54px -38px rgba(58, 35, 20, 0.32), inset 0 1px 0 rgba(255, 255, 255, 0.9);
  }

  .listing-hero :global(.section-heading),
  .section-split :global(.section-heading) {
    margin-bottom: 0;
  }

  .listing-hero__aside p,
  .section-note {
    margin: 0;
    max-width: none;
    color: var(--color-text-medium);
  }

  .listing-stats {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
    margin-top: 1.25rem;
  }

  .listing-stats article {
    padding: 1rem 1.1rem;
    border-radius: 1.25rem;
    background: rgba(255, 252, 247, 0.65);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.8);
  }

  .listing-stats span {
    display: block;
    margin-bottom: 0.45rem;
    font-size: 0.72rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-text-light);
    font-weight: 600;
  }

  .listing-stats strong {
    font-family: var(--font-family-serif);
    font-size: 1.6rem;
    color: var(--color-text-warm);
    font-variant-numeric: tabular-nums;
  }

  .section-split {
    margin-bottom: 2rem;
  }

  .listing-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.5rem;
  }

  .listing-grid__item--1 {
    grid-row: span 2;
  }

  .archive-section {
    margin-top: 5rem;
    padding-top: 2.5rem;
    border-top: 1px solid rgba(212, 175, 119, 0.22);
  }

  .empty-shell {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    padding: 3.5rem 2rem;
    text-align: center;
    border-radius: 1.8rem;
    background: rgba(255, 252, 247, 0.8);
    box-shadow: 0 28px 54px -38px rgba(58, 35, 20, 0.32), inset 0 1px 0 rgba(255, 255, 255, 0.92);
  }

  .empty-shell span {
    font-size: 2rem;
    color: var(--color-gold);
  }

  .empty-shell h2 {
    margin: 0;
    font-size: clamp(1.7rem, 3vw, 2.4rem);
    line-height: 1.05;
  }

  .empty-shell p {
    margin: 0;
    max-width: 44rem;
    color: var(--color-text-medium);
  }

  @media (max-width: 960px) {
    .container {
      width: min(100% - 1.5rem, 1200px);
    }

    .listing-hero,
    .section-split,
    .listing-grid {
      grid-template-columns: 1fr;
    }

    .listing-grid__item--1 {
      grid-row: auto;
    }

    .listing-page {
      padding: 3rem 0 4rem;
    }
  }
</style>
