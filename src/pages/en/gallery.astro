---
import Layout from '../../layouts/Layout.astro';
import GalleryGrid from '../../components/GalleryGrid.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import { useTranslations } from '../../i18n/utils';

const lang = 'en';
const t = useTranslations(lang);

const currentImages = [
  { src: '/images/gallery/ashram-courtyard-garden-archway.webp', srcThumb: '/images/optimized/gallery/ashram-courtyard-garden-archway-w480.webp', alt: 'Ashram courtyard with brick archway and garden', subHtml: 'Ashram courtyard and garden' },
  { src: '/images/gallery/winter-landscape-sunset-snow-hills.webp', srcThumb: '/images/optimized/gallery/winter-landscape-sunset-snow-hills-w480.webp', alt: 'Winter landscape with snowy hills at sunset', subHtml: 'Winter landscape around the ashram' },
  { src: '/images/gallery/sacred-temple-room-candles-altar.webp', srcThumb: '/images/optimized/gallery/sacred-temple-room-candles-altar-w480.webp', alt: 'Sacred temple room with altar, candles and rugs', subHtml: 'Temple interior' },
  { src: '/images/gallery/havan-procession-woman-offerings.webp', srcThumb: '/images/optimized/gallery/havan-procession-woman-offerings-w480.webp', alt: 'Woman in yellow sari carrying offerings during Aarti procession', subHtml: 'Aarti ceremony' },
  { src: '/images/gallery/sunset-trees-silhouette-twilight.webp', srcThumb: '/images/optimized/gallery/sunset-trees-silhouette-twilight-w480.webp', alt: 'Sunset with tree silhouettes in ashram gardens', subHtml: 'Sunset in the garden' },
  { src: '/images/gallery/vegetable-garden-leeks-organic.webp', srcThumb: '/images/optimized/gallery/vegetable-garden-leeks-organic-w480.webp', alt: 'Row of leeks in ashram organic garden', subHtml: 'Ashram vegetable garden' },
  { src: '/images/gallery/temple-room-babaji-portrait-altar.webp', srcThumb: '/images/optimized/gallery/temple-room-babaji-portrait-altar-w480.webp', alt: 'Meditation room with Babaji portrait on altar', subHtml: 'Altar with Babaji portrait' },
  { src: '/images/gallery/autumn-meadow-mountains-golden-grass.webp', srcThumb: '/images/optimized/gallery/autumn-meadow-mountains-golden-grass-w480.webp', alt: 'Autumn meadow with view of Golden Mountains', subHtml: 'View of Golden Mountains' },
  { src: '/images/gallery/temple-interior-altar-shiva-parvati.webp', srcThumb: '/images/optimized/gallery/temple-interior-altar-shiva-parvati-w480.webp', alt: 'Temple interior with altar and deity statues', subHtml: 'Altar in the temple' },
  { src: '/images/gallery/winter-road-snow-covered-trees-tractor.webp', srcThumb: '/images/optimized/gallery/winter-road-snow-covered-trees-tractor-w480.webp', alt: 'Winter road among snow-covered trees', subHtml: 'Winter road near the ashram' },
].map(img => ({ ...img, loading: 'lazy' as const }));

function generateAlbumImages(albumName: string, count: number, altPrefix: string) {
  return Array.from({ length: count }, (_, i) => {
    const num = String(i + 1).padStart(3, '0');
    return {
      src: `/images/gallery/albums/${albumName}/${albumName}-${num}.webp`,
      srcThumb: `/images/optimized/gallery/albums/${albumName}/${albumName}-${num}-w480.webp`,
      alt: `${altPrefix} - ${i + 1}`,
      loading: 'lazy' as const
    };
  });
}

const archiveAshramImages = generateAlbumImages('ashram-2001-2012', 45, 'Ashram life 2001-2012 - photo');
const archiveHavanImages = generateAlbumImages('havan-2000-2012', 28, 'Havan ceremonies 2000-2012 - photo');
const archiveEarlyImages = generateAlbumImages('1997-1998', 29, 'Early Days 1997-1998 - photo');

const archivalArticles = [
  { src: '/images/gallery/gazetki/radio-herakhan-kwiecien-czerwiec-1997.webp', srcThumb: '/images/optimized/gallery/gazetki/radio-herakhan-kwiecien-czerwiec-1997-w480.webp', alt: 'Newsletter Radio Herakhan - April June 1997', subHtml: 'Newsletter: Radio Herakhan April June 1997 <br> <a href="/documents/gazetki/radio-herakhan-kwiecien-czerwiec-1997.pdf" target="_blank" class="download-link">Download PDF</a>', loading: 'lazy' as const },
  { src: '/images/gallery/gazetki/radio-herakhan-lipiec-wrzesien-1997.webp', srcThumb: '/images/optimized/gallery/gazetki/radio-herakhan-lipiec-wrzesien-1997-w480.webp', alt: 'Newsletter Radio Herakhan - July September 1997', subHtml: 'Newsletter: Radio Herakhan July September 1997 <br> <a href="/documents/gazetki/radio-herakhan-lipiec-wrzesien-1997.pdf" target="_blank" class="download-link">Download PDF</a>', loading: 'lazy' as const },
  { src: '/images/gallery/gazetki/radio-herakhan-pazdziernik-luty-1997-1998-.webp', srcThumb: '/images/optimized/gallery/gazetki/radio-herakhan-pazdziernik-luty-1997-1998--w480.webp', alt: 'Newsletter Radio Herakhan - October February 1997-1998', subHtml: 'Newsletter: Radio Herakhan October February 1997-1998 <br> <a href="/documents/gazetki/radio-herakhan-pazdziernik-luty-1997-1998-.pdf" target="_blank" class="download-link">Download PDF</a>', loading: 'lazy' as const },
  { src: '/images/gallery/gazetki/radio-herakhan-marzec-grudzien-1998.webp', srcThumb: '/images/optimized/gallery/gazetki/radio-herakhan-marzec-grudzien-1998-w480.webp', alt: 'Newsletter Radio Herakhan - March December 1998', subHtml: 'Newsletter: Radio Herakhan March December 1998 <br> <a href="/documents/gazetki/radio-herakhan-marzec-grudzien-1998.pdf" target="_blank" class="download-link">Download PDF</a>', loading: 'lazy' as const },
  { src: '/images/gallery/gazetki/radio-herakhan-czerwiec-2000.webp', srcThumb: '/images/optimized/gallery/gazetki/radio-herakhan-czerwiec-2000-w480.webp', alt: 'Newsletter Radio Herakhan - June 2000', subHtml: 'Newsletter: Radio Herakhan June 2000 <br> <a href="/documents/gazetki/radio-herakhan-czerwiec-2000.pdf" target="_blank" class="download-link">Download PDF</a>', loading: 'lazy' as const },
  { src: '/images/gallery/gazetki/radio-herakhan-styczen-2002.webp', srcThumb: '/images/optimized/gallery/gazetki/radio-herakhan-styczen-2002-w480.webp', alt: 'Newsletter Radio Herakhan - January 2002', subHtml: 'Newsletter: Radio Herakhan January 2002 <br> <a href="/documents/gazetki/radio-herakhan-styczen-2002.pdf" target="_blank" class="download-link">Download PDF</a>', loading: 'lazy' as const },
  { src: '/images/gallery/gazetki/radio-herakhan-kwiecien-maj-2002.webp', srcThumb: '/images/optimized/gallery/gazetki/radio-herakhan-kwiecien-maj-2002-w480.webp', alt: 'Newsletter Radio Herakhan - April May 2002', subHtml: 'Newsletter: Radio Herakhan April May 2002 <br> <a href="/documents/gazetki/radio-herakhan-kwiecien-maj-2002.pdf" target="_blank" class="download-link">Download PDF</a>', loading: 'lazy' as const },
  { src: '/images/gallery/gazetki/radio-herakhan-grudzien-2005.webp', srcThumb: '/images/optimized/gallery/gazetki/radio-herakhan-grudzien-2005-w480.webp', alt: 'Newsletter Radio Herakhan - December 2005', subHtml: 'Newsletter: Radio Herakhan December 2005 <br> <a href="/documents/gazetki/radio-herakhan-grudzien-2005.pdf" target="_blank" class="download-link">Download PDF</a>', loading: 'lazy' as const },
];
---
<Layout title={t('nav.gallery')} description={t('meta.gallery.description')}>
  <div class="gallery-page">
    <div class="container">
      <div class="intro reveal">
        <div class="intro-shell">
          <div>
            <p class="eyebrow">images of the place</p>
            <SectionHeading title="Photo gallery" subtitle="Ceremonies, daily life, and archive material that show how the Ashram has been lived over the years." level={1} align="left" />
          </div>
          <div class="intro-aside">
            <p>
              This gallery is more than event documentation. It also shows the landscape, the work,
              and the ordinary atmosphere from which practice in Mąkolno grows.
            </p>
          </div>
        </div>
      </div>

      <div class="gallery-overview reveal-children">
        <article class="overview-card">
          <span>now</span>
          <strong>ashram life</strong>
          <p>recent photographs from practice, temple rooms, and the surrounding land</p>
        </article>
        <article class="overview-card overview-card--offset">
          <span>archive</span>
          <strong>1997-2012</strong>
          <p>early years, older ceremonies, and the gradual growth of the community</p>
        </article>
        <article class="overview-card">
          <span>documents</span>
          <strong>Radio Herakhan</strong>
          <p>scanned newsletters and reading material kept alongside the image archive</p>
        </article>
      </div>
      
      <!-- Current Life -->
      <div class="gallery-section">
        <GalleryGrid images={currentImages} title="Contemporary Ashram Life" />
      </div>

      <!-- Historical Ashram -->
      <div class="gallery-section">
        <GalleryGrid images={archiveAshramImages} title="Archive: Ashram (2001-2012)" />
      </div>

      <!-- Historical Havan -->
      <div class="gallery-section">
        <GalleryGrid images={archiveHavanImages} title="Archive: Havan (2000-2012)" />
      </div>

      <!-- Early Days -->
      <div class="gallery-section">
        <GalleryGrid images={archiveEarlyImages} title="Early Days (1997-1998)" />
      </div>

      <!-- Future: Budowa Ashramu -->
      <div class="gallery-section empty">
        <GalleryGrid images={[]} title="Ashram Construction" emptyStateText="Coming Soon" />
      </div>

      <!-- Archival Articles -->
      <div class="gallery-section">
        <GalleryGrid images={archivalArticles} title="Archival Newsletters: Radio Herakhan" />
      </div>
      <div class="gallery-section empty">
        <GalleryGrid images={[]} title="Archival Articles" emptyStateText="Coming Soon" />
      </div>

    </div>
  </div>
</Layout>

<style>
  .gallery-page {
    padding: 4rem 0 5rem;
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 2rem;
  }

  .intro {
    margin-bottom: 2rem;
  }

  .intro-shell {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(18rem, 24rem);
    gap: 2rem;
    align-items: end;
    padding: 2.25rem;
    border-radius: 2rem;
    background: rgba(255, 252, 247, 0.76);
    box-shadow: 0 28px 54px -38px rgba(58, 35, 20, 0.32), inset 0 1px 0 rgba(255, 255, 255, 0.9);
  }

  .intro-shell :global(.section-heading) {
    margin-bottom: 0;
  }

  .eyebrow {
    margin: 0 0 1rem;
    font-size: 0.72rem;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--color-text-light);
    font-weight: 600;
  }

  .intro-aside p {
    margin: 0;
    max-width: none;
    color: var(--color-text-medium);
  }

  .gallery-overview {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
    margin-bottom: 2rem;
  }

  .overview-card {
    padding: 1.4rem 1.5rem;
    border-radius: 1.5rem;
    background: rgba(255, 252, 247, 0.66);
    box-shadow: 0 22px 40px -34px rgba(58, 35, 20, 0.28), inset 0 1px 0 rgba(255, 255, 255, 0.84);
  }

  .overview-card--offset {
    transform: translateY(1.4rem);
  }

  .overview-card span {
    display: block;
    margin-bottom: 0.55rem;
    font-size: 0.72rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-orange);
    font-weight: 600;
  }

  .overview-card strong {
    display: block;
    font-family: var(--font-family-serif);
    font-size: 1.35rem;
    line-height: 1.05;
    color: var(--color-text-warm);
  }

  .overview-card p {
    margin: 0.5rem 0 0;
    max-width: none;
    color: var(--color-text-medium);
  }

  .gallery-section {
    margin-bottom: 4rem;
    position: relative;
  }
  
  .gallery-section::after {
    content: '';
    display: block;
    width: 60px;
    height: 2px;
    background: var(--color-gold);
    margin: 4rem auto 0;
    opacity: 0.3;
  }
  
  .gallery-section:last-child::after {
    display: none;
  }

  @media (max-width: 960px) {
    .intro-shell,
    .gallery-overview {
      grid-template-columns: 1fr;
    }

    .overview-card--offset {
      transform: none;
    }
  }
</style>
