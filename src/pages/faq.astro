---
import Layout from '../layouts/Layout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import FAQSchema from '../components/FAQSchema.astro';
import { useTranslations } from '../i18n/utils';

const lang = 'pl';
const t = useTranslations(lang);

const faqs = [
  {
    question: 'Czym jest Ashram Babaji w Polsce?',
    answer: 'Ashram Babaji to ośrodek duchowy poświęcony naukom Śri Haidakhan Babaji, oparty na Prawdzie, Prostocie i Miłości. Nasza siedziba znajduje się w Mąkolnie.'
  },
  {
    question: 'Czy muszę się wcześniej umówić na wizytę?',
    answer: 'Tak. Prosimy o kontakt mailowy lub telefoniczny przed planowaną wizytą, abyśmy mogli przygotować pobyt.'
  },
  {
    question: 'Jak wygląda typowy dzień w Ashramie?',
    answer: 'Dzień obejmuje poranną medytację, praktykę mantry, pracę jako służbę (Karma Yoga) oraz ceremonie Aarti i Havan. Rytm dnia sprzyja ciszy i uważności.'
  },
  {
    question: 'Jakie praktyki duchowe są w Ashramie?',
    answer: 'Główne praktyki to Karma Yoga, Japa Yoga (Om Namah Shivaya), Havan, Aarti oraz medytacja. Nauczanie jest uniwersalne i otwarte dla wszystkich.'
  },
  {
    question: 'Czy mogę przyjechać jako początkujący?',
    answer: 'Tak. Wspólnota wprowadza nowych uczestników w praktyki i rytm dnia.'
  },
  {
    question: 'Gdzie dokładnie znajduje się Ashram?',
    answer: 'Siedziba: Mąkolno 129, 57-250 Mąkolno (Dolny Śląsk).'
  },
  {
    question: 'Czy Ashram organizuje wydarzenia i warsztaty?',
    answer: 'Tak. Organizujemy ceremonie, rekolekcje i święta duchowe. Sprawdź aktualne wydarzenia na stronie Wydarzenia.'
  },
  {
    question: 'Jak mogę wesprzeć Ashram?',
    answer: 'Ashram utrzymuje się z dobrowolnych darowizn. Szczegóły znajdziesz na stronie Darowizny.'
  },
  {
    question: 'Czy mogę pomóc jako wolontariusz?',
    answer: 'Tak. Pomoc w kuchni, ogrodzie i utrzymaniu ośrodka jest mile widziana. Skontaktuj się z nami, aby ustalić szczegóły.'
  },
  {
    question: 'Kim był Śri Haidakhan Babaji?',
    answer: 'Babaji nauczał praktyki mantry i bezinteresownej służby. Jego przesłanie jest uniwersalne i zachęca do podążania ścieżką serca.'
  },
  {
    question: 'Co zabrać na retreat?',
    answer: 'Warto zabrać wygodne ubrania, śpiwór, matę i obuwie na zewnątrz. Szczegóły zawsze potwierdzamy przed wyjazdem.'
  },
  {
    question: 'W jakich językach dostępna jest strona?',
    answer: 'Strona dostępna jest w języku polskim i angielskim. Język zmienisz w nagłówku.'
  }
];
---

<Layout title="FAQ" description="Odpowiedzi na najczęściej zadawane pytania o wizyty w Ashramie Babaji, praktyki i wydarzenia.">
  <section class="faq-page">
    <div class="container">
      <Breadcrumb items={[{ label: t('nav.home'), href: '/' }, { label: 'FAQ' }]} />
      <SectionHeading title="Najczęściej zadawane pytania" subtitle="Praktyczne informacje o aszramie" level={1} />

      <div class="faq-list">
        {faqs.map((faq) => (
          <div class="faq-item">
            <h3>{faq.question}</h3>
            <p>{faq.answer}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <FAQSchema faqs={faqs} />
</Layout>

<style>
  .faq-page {
    padding: 4rem 0;
  }

  .container {
    max-width: 900px;
    margin: 0 auto;
    padding: 0 2rem;
  }

  .faq-list {
    margin-top: 3rem;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));
    gap: 3rem 2rem;
  }

  .faq-item {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    position: relative;
    padding-left: 1.5rem;
  }

  /* Decorative vertical line instead of borders */
  .faq-item::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 2px;
    background: linear-gradient(180deg, var(--color-orange), transparent);
    opacity: 0.5;
    border-radius: 2px;
  }

  .faq-item h3 {
    font-size: 1.25rem;
    color: var(--color-text);
    margin: 0;
    font-family: var(--font-family-sans);
    font-weight: 600;
  }

  .faq-item p {
    margin: 0;
    color: var(--color-text-light);
    line-height: 1.6;
    font-size: 1.05rem;
  }
</style>
