---
import Layout from '../layouts/Layout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import { useTranslations } from '../i18n/utils';

const lang = 'pl';
const t = useTranslations(lang);
---

<Layout title="Praktyki" description={t('meta.practices.description')}>
  <section class="practices-page">
    <div class="container">
      <Breadcrumb items={[{ label: t('nav.home'), href: '/' }, { label: 'Praktyki' }]} />
      <SectionHeading title="Praktyki Duchowe" subtitle="Karma Yoga, japa, Havan, Aarti" level={1} />

      <p class="intro">
        Praktyki w tradycji Babadżiego są proste, ale głębokie. Pomagają budować uważność
        i serce otwarte na służbę. Poznaj też <a href="/teachings">nauki Babaji</a>
        oraz <a href="/rekolekcje">rekolekcje</a>.
      </p>

      <div class="practices-grid">
        <div class="practice-card">
          <h2>Karma Yoga</h2>
          <p>
            Praca jako służba i modlitwa. Codzienne czynności wykonywane z pełną uwagą oczyszczają umysł.
            Zobacz <a href="/teachings/karma-yoga">Karma Yoga</a>.
          </p>
        </div>

        <div class="practice-card">
          <h2>Nama Japa</h2>
          <p>
            Powtarzanie mantry Om Namah Shivaya to fundament praktyki. Wspiera koncentrację i spokój.
            Dowiedz się więcej w tekście <a href="/teachings/nama-japa">Nama Japa</a>.
          </p>
        </div>

        <div class="practice-card">
          <h2>Havan</h2>
          <p>
            Ceremonia ognia oczyszcza i wzmacnia wspólnotę. Więcej w nauce
            <a href="/teachings/havan-ogien">Havan</a> oraz na stronie <a href="/events">poniedziałkowych ceremonii</a>.
          </p>
        </div>

        <div class="practice-card">
          <h2>Aarti</h2>
          <p>
            Ceremonia światła odprawiana rano i wieczorem tworzy rytm dnia. Zobacz
            <a href="/teachings/aarti-ceremonia">Aarti</a>.
          </p>
        </div>

        <div class="practice-card" style="grid-column: 1 / -1; max-width: 600px; justify-self: center; text-align: center;">
          <h2>Medytacja i Kriya Yoga</h2>
          <p>
            Medytacja to przestrzeń ciszy, w której spotykają się Prawda, Prostota i Miłość.
            Zacznij od <a href="/teachings/medytacja-dla-poczatkujacych">medytacji dla początkujących</a>
            i poznaj <a href="/teachings/kriya-yoga">Kriya Yogę</a>.
          </p>
        </div>
      </div>

      <div class="cta">
        <a href="/contact" class="btn-primary">Skontaktuj się</a>
        <a href="/events" class="btn-secondary">Praktykuj w aszramie</a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .practices-page {
    padding: 4rem 0;
  }

  .container {
    max-width: 900px;
    margin: 0 auto;
    padding: 0 2rem;
  }

  .intro {
    font-size: 1.1rem;
    line-height: 1.7;
    color: var(--color-text-light);
    margin: 1.5rem 0 2.5rem;
  }

  .intro a {
    color: var(--color-orange);
    text-decoration: none;
  }

  .cta {
    margin-top: 3.5rem;
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
    justify-content: center;
  }

  .practices-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 2rem;
    margin-top: 3rem;
  }

  .practice-card {
    background: linear-gradient(
      135deg,
      rgba(255, 252, 247, 0.85) 0%,
      rgba(250, 248, 245, 0.65) 50%,
      rgba(255, 252, 247, 0.85) 100%
    );
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-radius: var(--radius-l);
    padding: 2.5rem;
    box-shadow: 
      0 12px 32px -8px var(--color-amber-glow),
      inset 0 1px 1px rgba(255, 255, 255, 0.9),
      inset 0 -1px 1px rgba(212, 175, 119, 0.1);
    transition: all 0.5s cubic-bezier(0.175, 0.885, 0.32, 1.275);
  }

  .practice-card:hover {
    transform: translateY(-4px) scale(1.01);
    box-shadow: 
      0 20px 40px -10px rgba(230, 168, 104, 0.4),
      0 8px 24px -6px rgba(155, 85, 57, 0.2),
      inset 0 1px 1px rgba(255, 255, 255, 1),
      inset 0 -1px 1px rgba(212, 175, 119, 0.1);
  }

  .practice-card h2 {
    font-family: var(--font-family-serif);
    font-size: 1.6rem;
    color: var(--color-text);
    margin-top: 0;
    margin-bottom: 1rem;
  }

  .practice-card p {
    color: var(--color-text-light);
    line-height: 1.7;
    margin: 0;
  }
</style>
