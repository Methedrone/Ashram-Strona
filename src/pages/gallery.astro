---
import Layout from '../layouts/Layout.astro';
import GalleryGrid from '../components/GalleryGrid.astro';
import SectionHeading from '../components/SectionHeading.astro';
import { useTranslations } from '../i18n/utils';

const lang = 'pl';
const t = useTranslations(lang);

const currentImages = [
  { src: '/images/gallery/ashram-courtyard-garden-archway.webp', srcThumb: '/images/optimized/gallery/ashram-courtyard-garden-archway-w480.webp', alt: 'Dziedziniec aszramu z ceglanym przejściem i ogrodem', subHtml: 'Dziedziniec aszramu z ogrodem' },
  { src: '/images/gallery/winter-landscape-sunset-snow-hills.webp', srcThumb: '/images/optimized/gallery/winter-landscape-sunset-snow-hills-w480.webp', alt: 'Zimowy krajobraz ze śnieżnymi wzgórzami o zachodzie słońca', subHtml: 'Zimowy krajobraz wokół aszramu' },
  { src: '/images/gallery/sacred-temple-room-candles-altar.webp', srcThumb: '/images/optimized/gallery/sacred-temple-room-candles-altar-w480.webp', alt: 'Świątynia z ołtarzem, świece i dywany', subHtml: 'Wnętrze świątyni' },
  { src: '/images/gallery/havan-procession-woman-offerings.webp', srcThumb: '/images/optimized/gallery/havan-procession-woman-offerings-w480.webp', alt: 'Kobieta w żółtym sari niosąca ofiary podczas procesji Aarti', subHtml: 'Ceremonia Aarti' },
  { src: '/images/gallery/sunset-trees-silhouette-twilight.webp', srcThumb: '/images/optimized/gallery/sunset-trees-silhouette-twilight-w480.webp', alt: 'Zachód słońca z sylwetkami drzew w ogrodzie aszramu', subHtml: 'Zachód słońca w ogrodzie' },
  { src: '/images/gallery/vegetable-garden-leeks-organic.webp', srcThumb: '/images/optimized/gallery/vegetable-garden-leeks-organic-w480.webp', alt: 'Rząd pora w organicznym ogrodzie aszramu', subHtml: 'Ogród warzywny aszramu' },
  { src: '/images/gallery/temple-room-babaji-portrait-altar.webp', srcThumb: '/images/optimized/gallery/temple-room-babaji-portrait-altar-w480.webp', alt: 'Pokój medytacyjny z portretem Babaji na ołtarzu', subHtml: 'Ołtarz z portretem Babaji' },
  { src: '/images/gallery/autumn-meadow-mountains-golden-grass.webp', srcThumb: '/images/optimized/gallery/autumn-meadow-mountains-golden-grass-w480.webp', alt: 'Jesienna łąka z widokiem na Góry Złote', subHtml: 'Widok na Góry Złote' },
  { src: '/images/gallery/temple-interior-altar-shiva-parvati.webp', srcThumb: '/images/optimized/gallery/temple-interior-altar-shiva-parvati-w480.webp', alt: 'Wnętrze świątyni z ołtarzem i statuetkami bożków', subHtml: 'Ołtarz w świątyni' },
  { src: '/images/gallery/winter-road-snow-covered-trees-tractor.webp', srcThumb: '/images/optimized/gallery/winter-road-snow-covered-trees-tractor-w480.webp', alt: 'Zimowa droga wśród zaśnieżonych drzew', subHtml: 'Zimowa droga w okolicy aszramu' },
].map(img => ({ ...img, loading: 'lazy' as const }));

function generateAlbumImages(albumName: string, count: number, altPrefix: string) {
  return Array.from({ length: count }, (_, i) => {
    const num = String(i + 1).padStart(3, '0');
    return {
      src: `/images/gallery/albums/${albumName}/${albumName}-${num}.webp`,
      srcThumb: `/images/optimized/gallery/albums/${albumName}/${albumName}-${num}-w480.webp`,
      alt: `${altPrefix} - ${i + 1}`,
      loading: 'lazy' as const
    };
  });
}

const archiveAshramImages = generateAlbumImages('ashram-2001-2012', 45, 'Życie w ashramie 2001-2012 - zdjęcie');
const archiveHavanImages = generateAlbumImages('havan-2000-2012', 28, 'Ceremonie Havan 2000-2012 - zdjęcie');
const archiveEarlyImages = generateAlbumImages('1997-1998', 29, 'Początki Ashramu 1997-1998 - zdjęcie');

const archivalArticles = [
  { src: '/images/gallery/gazetki/radio-herakhan-kwiecien-czerwiec-1997.webp', srcThumb: '/images/optimized/gallery/gazetki/radio-herakhan-kwiecien-czerwiec-1997-w480.webp', alt: 'Gazetka Radio Herakhan - Radio Herakhan Kwiecien Czerwiec 1997', subHtml: 'Gazetka: Radio Herakhan Kwiecien Czerwiec 1997 <br> <a href="/documents/gazetki/radio-herakhan-kwiecien-czerwiec-1997.pdf" target="_blank" class="download-link">Pobierz PDF</a>', loading: 'lazy' as const },
  { src: '/images/gallery/gazetki/radio-herakhan-lipiec-wrzesien-1997.webp', srcThumb: '/images/optimized/gallery/gazetki/radio-herakhan-lipiec-wrzesien-1997-w480.webp', alt: 'Gazetka Radio Herakhan - Radio Herakhan Lipiec Wrzesien 1997', subHtml: 'Gazetka: Radio Herakhan Lipiec Wrzesien 1997 <br> <a href="/documents/gazetki/radio-herakhan-lipiec-wrzesien-1997.pdf" target="_blank" class="download-link">Pobierz PDF</a>', loading: 'lazy' as const },
  { src: '/images/gallery/gazetki/radio-herakhan-pazdziernik-luty-1997-1998-.webp', srcThumb: '/images/optimized/gallery/gazetki/radio-herakhan-pazdziernik-luty-1997-1998--w480.webp', alt: 'Gazetka Radio Herakhan - Radio Herakhan Pazdziernik Luty 1997-1998', subHtml: 'Gazetka: Radio Herakhan Pazdziernik Luty 1997-1998 <br> <a href="/documents/gazetki/radio-herakhan-pazdziernik-luty-1997-1998-.pdf" target="_blank" class="download-link">Pobierz PDF</a>', loading: 'lazy' as const },
  { src: '/images/gallery/gazetki/radio-herakhan-marzec-grudzien-1998.webp', srcThumb: '/images/optimized/gallery/gazetki/radio-herakhan-marzec-grudzien-1998-w480.webp', alt: 'Gazetka Radio Herakhan - Radio Herakhan Marzec Grudzien 1998', subHtml: 'Gazetka: Radio Herakhan Marzec Grudzien 1998 <br> <a href="/documents/gazetki/radio-herakhan-marzec-grudzien-1998.pdf" target="_blank" class="download-link">Pobierz PDF</a>', loading: 'lazy' as const },
  { src: '/images/gallery/gazetki/radio-herakhan-czerwiec-2000.webp', srcThumb: '/images/optimized/gallery/gazetki/radio-herakhan-czerwiec-2000-w480.webp', alt: 'Gazetka Radio Herakhan - Radio Herakhan Czerwiec 2000', subHtml: 'Gazetka: Radio Herakhan Czerwiec 2000 <br> <a href="/documents/gazetki/radio-herakhan-czerwiec-2000.pdf" target="_blank" class="download-link">Pobierz PDF</a>', loading: 'lazy' as const },
  { src: '/images/gallery/gazetki/radio-herakhan-styczen-2002.webp', srcThumb: '/images/optimized/gallery/gazetki/radio-herakhan-styczen-2002-w480.webp', alt: 'Gazetka Radio Herakhan - Radio Herakhan Styczen 2002', subHtml: 'Gazetka: Radio Herakhan Styczen 2002 <br> <a href="/documents/gazetki/radio-herakhan-styczen-2002.pdf" target="_blank" class="download-link">Pobierz PDF</a>', loading: 'lazy' as const },
  { src: '/images/gallery/gazetki/radio-herakhan-kwiecien-maj-2002.webp', srcThumb: '/images/optimized/gallery/gazetki/radio-herakhan-kwiecien-maj-2002-w480.webp', alt: 'Gazetka Radio Herakhan - Radio Herakhan Kwiecien Maj 2002', subHtml: 'Gazetka: Radio Herakhan Kwiecien Maj 2002 <br> <a href="/documents/gazetki/radio-herakhan-kwiecien-maj-2002.pdf" target="_blank" class="download-link">Pobierz PDF</a>', loading: 'lazy' as const },
  { src: '/images/gallery/gazetki/radio-herakhan-grudzien-2005.webp', srcThumb: '/images/optimized/gallery/gazetki/radio-herakhan-grudzien-2005-w480.webp', alt: 'Gazetka Radio Herakhan - Radio Herakhan Grudzien 2005', subHtml: 'Gazetka: Radio Herakhan Grudzien 2005 <br> <a href="/documents/gazetki/radio-herakhan-grudzien-2005.pdf" target="_blank" class="download-link">Pobierz PDF</a>', loading: 'lazy' as const },
];
---
<Layout title={t('nav.gallery')} description={t('meta.gallery.description')}>
  <div class="gallery-page">
    <div class="container">
      <div class="intro reveal">
        <div class="intro-shell">
          <div>
            <p class="eyebrow">obrazy miejsca</p>
            <SectionHeading title="Galeria zdjęć" subtitle="Ceremonie, codzienne życie i archiwalne obrazy, które pokazują rytm ashramu na przestrzeni lat." level={1} align="left" />
          </div>
          <div class="intro-aside">
            <p>
              Ta galeria nie jest tylko dokumentacją wydarzeń. Pokazuje także krajobraz, pracę i codzienną atmosferę,
              z której wyrasta praktyka w Mąkolnie.
            </p>
          </div>
        </div>
      </div>

      <div class="gallery-overview reveal-children">
        <article class="overview-card">
          <span>teraz</span>
          <strong>życie ashramu</strong>
          <p>najnowsze zdjęcia z praktyki, świątyni i otoczenia</p>
        </article>
        <article class="overview-card overview-card--offset">
          <span>archiwum</span>
          <strong>1997-2012</strong>
          <p>początki miejsca, dawne ceremonie i rozwój wspólnoty</p>
        </article>
        <article class="overview-card">
          <span>materiały</span>
          <strong>Radio Herakhan</strong>
          <p>zeskanowane gazetki i dokumenty do dalszego czytania</p>
        </article>
      </div>
      
      <!-- Current Life -->
      <div class="gallery-section reveal">
        <GalleryGrid images={currentImages} title="Współczesne życie Ashramu" />
      </div>

      <!-- Historical Ashram -->
      <div class="gallery-section reveal">
        <GalleryGrid images={archiveAshramImages} title="Archiwum: Ashram (2001-2012)" />
      </div>

      <!-- Historical Havan -->
      <div class="gallery-section reveal">
        <GalleryGrid images={archiveHavanImages} title="Archiwum: Havan (2000-2012)" />
      </div>

      <!-- Early Days -->
      <div class="gallery-section reveal">
        <GalleryGrid images={archiveEarlyImages} title="Początki Ashramu (1997-1998)" />
      </div>

      <!-- Future: Budowa Ashramu -->
      <div class="gallery-section reveal empty">
        <GalleryGrid images={[]} title="Budowa Ashramu" emptyStateText="Wkrótce" />
      </div>

      <!-- Historical Articles -->
      <div class="gallery-section reveal">
        <GalleryGrid images={archivalArticles} title="Gazetki Archiwalne: Radio Herakhan" />
      </div>

    </div>
  </div>
</Layout>

<style>
  .gallery-page {
    padding: 4rem 0 5rem;
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 2rem;
  }

  .intro {
    margin-bottom: 2rem;
  }

  .intro-shell {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(18rem, 24rem);
    gap: 2rem;
    align-items: end;
    padding: 2.25rem;
    border-radius: 2rem;
    background: rgba(255, 252, 247, 0.76);
    box-shadow: 0 28px 54px -38px rgba(58, 35, 20, 0.32), inset 0 1px 0 rgba(255, 255, 255, 0.9);
  }

  .intro-shell :global(.section-heading) {
    margin-bottom: 0;
  }

  .eyebrow {
    margin: 0 0 1rem;
    font-size: 0.72rem;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--color-text-light);
    font-weight: 600;
  }

  .intro-aside p {
    margin: 0;
    max-width: none;
    color: var(--color-text-medium);
  }

  .gallery-overview {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
    margin-bottom: 2rem;
  }

  .overview-card {
    padding: 1.4rem 1.5rem;
    border-radius: 1.5rem;
    background: rgba(255, 252, 247, 0.66);
    box-shadow: 0 22px 40px -34px rgba(58, 35, 20, 0.28), inset 0 1px 0 rgba(255, 255, 255, 0.84);
  }

  .overview-card--offset {
    transform: translateY(1.4rem);
  }

  .overview-card span {
    display: block;
    margin-bottom: 0.55rem;
    font-size: 0.72rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-orange);
    font-weight: 600;
  }

  .overview-card strong {
    display: block;
    font-family: var(--font-family-serif);
    font-size: 1.35rem;
    line-height: 1.05;
    color: var(--color-text-warm);
  }

  .overview-card p {
    margin: 0.5rem 0 0;
    max-width: none;
    color: var(--color-text-medium);
  }

  .gallery-section {
    margin-bottom: 4rem;
    position: relative;
  }
  
  .gallery-section::after {
    content: '';
    display: block;
    width: 60px;
    height: 2px;
    background: var(--color-gold);
    margin: 4rem auto 0;
    opacity: 0.3;
  }
  
  .gallery-section:last-child::after {
    display: none;
  }

  /* Styl dla linku do pobrania w opisie zdjęcia */
  :global(.download-link) {
    display: inline-block;
    margin-top: 0.5rem;
    padding: 0.3rem 0.8rem;
    background-color: var(--color-orange);
    color: white !important;
    border-radius: 4px;
    text-decoration: none;
    font-size: 0.9rem;
    font-weight: bold;
    transition: background-color 0.2s;
  }

  :global(.download-link:hover) {
    background-color: var(--color-orange-dark, #e67e22);
  }

  @media (max-width: 960px) {
    .intro-shell,
    .gallery-overview {
      grid-template-columns: 1fr;
    }

    .overview-card--offset {
      transform: none;
    }
  }
</style>
